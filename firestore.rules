rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'sudhansu1906@gmail.com' ||
        request.auth.token.email == 'adititulsyan388@gmail.com'
      );
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getMgmtDoc() {
      return get(/databases/$(database)/documents/management_users/$(request.auth.uid)).data;
    }

    function isManagementUser() {
      return exists(/databases/$(database)/documents/management_users/$(request.auth.uid)) &&
        (getMgmtDoc().role == 'admin' || getMgmtDoc().role == 'management' || getMgmtDoc().role == 'staff') &&
        getMgmtDoc().status != 'Inactive' &&
        getMgmtDoc().status != 'Suspended';
    }

    function isUserAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserDoc().role == 'admin' || getUserDoc().role == 'management' || getUserDoc().role == 'staff') &&
        getUserDoc().status != 'Inactive' &&
        getUserDoc().status != 'Suspended';
    }

    function isAdminOrManagement() {
      return isSuperAdmin() || (isAuthenticated() && (isUserAdmin() || isManagementUser()));
    }

    // =========================================================================
    // 0. Registration Lookup (Public resolution for Registration Number -> Email)
    // =========================================================================

    match /registration_lookup/{identifier} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // 1. Users & Resident Profiles
    // =========================================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAdminOrManagement();
      allow update: if isAdminOrManagement() || (
        (isOwner(userId) || (isAuthenticated() && (resource.data.email == request.auth.token.email || resource.data.authUid == request.auth.uid))) &&
        // Students cannot elevate role, alter fee structures, or self-assign rooms
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'status', 'monthlyRent', 'securityDeposit', 'room', 'building', 'plan'
        ])
      );
      allow delete: if isAdminOrManagement();

      // Subcollections (personal notes, student notifications, personal todos)
      match /personal_notes/{noteId} {
        allow read, write: if isOwner(userId) || isAdminOrManagement();
      }
      match /personal_todos/{todoId} {
        allow read, write: if isAuthenticated() && (
          isOwner(userId) ||
          isAdminOrManagement() ||
          userId == 'default_admin' ||
          request.auth.uid == userId
        );
      }
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId) ||
                              (isAuthenticated() && (
                                get(/databases/$(database)/documents/users/$(userId)).data.email == request.auth.token.email ||
                                get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid
                              )) ||
                              isAdminOrManagement();
      }
    }

    // Students collection fallback
    match /students/{studentId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 2. Bills & Payment Collection
    // =========================================================================

    match /bills/{billId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrManagement();
      allow update: if isAdminOrManagement() || (
        isAuthenticated() &&
        // Residents can only submit payment proof and transition to Pending Verification
        request.resource.data.status != 'Paid' &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.paidAmount == resource.data.paidAmount
      );
      allow delete: if isAdminOrManagement();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrManagement();
    }

    // =========================================================================
    // 3. Maintenance Complaints & Helpdesk
    // =========================================================================

    match /complaints/{complaintId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdminOrManagement() || (
        isAuthenticated() &&
        // Residents cannot edit administrative feedback or resolve tickets themselves
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminRemarks', 'resolvedAt'])
      );
      allow delete: if isAdminOrManagement();
    }

    // =========================================================================
    // 4. Broadcast Notices & Announcements
    // =========================================================================

    match /broadcast_notifications/{noticeId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrManagement();
    }

    // =========================================================================
    // 5. Properties, Buildings & Spaces
    // =========================================================================

    match /buildings/{buildingId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrManagement();
    }

    // =========================================================================
    // 6. Mess Menu & Schedules
    // =========================================================================

    match /mess_menus/{messId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrManagement();
    }

    match /mess_menu/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrManagement();
    }

    // =========================================================================
    // 7. Staff & Operations
    // =========================================================================

    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrManagement();
    }

    // =========================================================================
    // 8. Management Ledger: Expenses, Buckets & Admin Tasks
    // =========================================================================

    match /expenses/{expenseId} {
      allow read, write: if isAdminOrManagement();
    }

    match /expense_buckets/{bucketId} {
      allow read, write: if isAdminOrManagement();
    }

    match /admin_todos/{todoId} {
      allow read, write: if isAdminOrManagement() || isAuthenticated();
    }

    match /personal_todos/{todoId} {
      allow read, write: if isAuthenticated();
    }

    match /management_users/{userId} {
      allow read, write: if isAdminOrManagement();
    }

    match /onboarding_drafts/{draftId} {
      allow read, write: if isAdminOrManagement();
    }

    match /system_counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    match /mail/{mailId} {
      allow read, write: if isAuthenticated();
    }

    match /email_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrManagement();
    }

    // =========================================================================
    // 9. Account Deletion Requests
    // =========================================================================

    match /account_deletion_requests/{requestId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdminOrManagement();
    }
  }
}
